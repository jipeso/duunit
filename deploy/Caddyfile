www.duunit.site {
  redir https://duunit.site{uri} permanent
}

duunit.site {
  encode gzip zstd
  header {
    Strict-Transport-Security "max-age=31536000"
    Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Via
  }
  reverse_proxy 127.0.0.1:3000
}