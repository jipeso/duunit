{
  "name": "duunit",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/jipeso/duunit#readme",
  "bugs": {
    "url": "https://github.com/jipeso/duunit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jipeso/duunit.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "imports": {
    "#common/*": "./src/common/*",
    "#server/*": "./src/server/*",
    "#client/*": "./src/client/*"
  },
  "scripts": {
    "start": "docker compose up",
    "start:prod": "NODE_ENV=production node src/server/index.ts",
    "start:dev": "NODE_ENV=development concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "start:test": "NODE_ENV=test node src/server/index.ts",
    "dev:client": "vite",
    "dev:server": "node --watch src/server/index.ts",
    "build": "npm run typecheck && vite build",
    "lint": "concurrently --kill-others-on-fail -raw \"npm run typecheck\" \"eslint --flag unstable_native_nodejs_ts_config\"",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.4.0",
    "vite": "^8.3.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.0",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true
  }
}
